# Adresse de la base PostgreSQL
DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@127.0.0.1:5432/signal_arnaque
# Clé de signature des jetons, OBLIGATOIRE : 32 caractères aléatoires au moins, à garder secrète.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=a-remplacer
# true seulement derrière un proxy de confiance (Nginx, hébergeur) qui écrit X-Forwarded-For
TRUST_PROXY=false
# true pour afficher la documentation interactive sur /api/docs
API_DOCS=false
